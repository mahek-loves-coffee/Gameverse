# Local development: leave VITE_API_URL empty to use the Vite proxy.
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters

# Production frontend (Vercel): set this in Vercel Project Settings > Environment Variables.
# VITE_API_URL=https://YOUR-RENDER-SERVICE.onrender.com

# Production backend (Render): set these in Render Environment.
# DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@HOST:5432/postgres
# CLIENT_ORIGIN=https://YOUR-VERCEL-PROJECT.vercel.app
# SESSION_SECRET=generate-a-unique-random-secret-at-least-32-characters
# NODE_ENV=production
# DB_POOL_MAX=5
