{
  "name": "the-gameverse",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm:server:dev\" \"npm:client:dev\"",
    "client:dev": "vite --host 0.0.0.0",
    "server:dev": "node --env-file-if-exists=.env --watch server/index.js",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.js",
    "check": "node --check server/index.js && node --check server/db.js && node --check server/sqlDialect.js && node --check server/roomFactory.js && node --check scripts/migrate-sqlite-to-postgres.js && node --test tests/*.test.js",
    "test": "node --test tests/*.test.js",
    "migrate:sqlite": "node scripts/migrate-sqlite-to-postgres.js",
    "prebuild": "node -e \"const fs=require('node:fs'); for (const f of ['index.html','src/main.jsx','src/App.jsx']) { if (!fs.existsSync(f)) { console.error('Missing required frontend file: '+f); process.exit(1); } }\""
  },
  "dependencies": {
    "@react-three/drei": "9.122.0",
    "@react-three/fiber": "8.17.10",
    "bcryptjs": "2.4.3",
    "cookie-parser": "1.4.7",
    "express": "4.22.3",
    "helmet": "8.0.0",
    "lucide-react": "0.468.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.6",
    "socket.io": "4.8.1",
    "socket.io-client": "4.8.1",
    "three": "0.170.0",
    "express-rate-limit": "7.5.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "4.3.4",
    "concurrently": "9.1.2",
    "vite": "6.4.6",
    "better-sqlite3": "11.7.0"
  },
  "engines": {
    "node": "22.x"
  }
}
